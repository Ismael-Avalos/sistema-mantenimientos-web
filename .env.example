# Copiar a .env.local en la raíz del frontend (junto a package.json), no en src/.
# URL pública de la API Spring Boot, sin barra final ni /api.
# En Vercel: VITE_API_URL=https://sistema-de-mantenimientos.onrender.com
VITE_API_URL=http://localhost:8080

# Opcional: URL pública del FRONTEND para generar enlaces QR, sin barra final.
# Si queda vacía, se utiliza el origen del navegador (local o Vercel).
VITE_APP_URL=
